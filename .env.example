# 数据库（PostgreSQL 16 + pgvector，示例端口 5433）
DATABASE_URL=postgresql+psycopg2://coach:coach@localhost:5433/coach_v2

# 主力模型（OpenAI 兼容端点注册表见 app/config.py）
MODEL_PROVIDER=deepseek
MODEL_PRIMARY=deepseek-chat
# 兜底模型（主力故障时自动降级）
FALLBACK_PROVIDER=dashscope
MODEL_FALLBACK=qwen-plus-latest

# Embedding（DashScope）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# API Key（填你自己的）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 护栏：出处校验违规打回重答次数
GUARD_MAX_RETRIES=1

# 系统提示词版本（app/prompts/system_vX.Y.md）
SYSTEM_PROMPT_VERSION=v0.3
